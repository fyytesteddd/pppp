local function GetOxygenLevel()
    local gui = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
    if gui then
        local main = gui:FindFirstChild("Main")
        if main then
            local oxygenFrame = main:FindFirstChild("Oxygen")
