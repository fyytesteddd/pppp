local function GetAllFish()
    local fishList = {}
    allFishData = {}
    
    local RS = game:GetService("ReplicatedStorage")
    local fishPresets = RS:FindFirstChild("common")
    if fishPresets then
        fishPresets = fishPresets:FindFirstChild("presets")
        if fishPresets then
            fishPresets = fishPresets:FindFirstChild("items")
            if fishPresets then
                fishPresets = fishPresets:FindFirstChild("fish")
                if fishPresets then
                    -- Scan all zones
                    for _, zone in ipairs(fishPresets:GetChildren()) do
                        local zoneName = zone.Name
                        
                        -- Get all fish in this zone
                        for _, fishData in ipairs(zone:GetChildren()) do
                            local fishName = fishData.Name
                            
                            -- Only add if not already in list (avoid duplicates)
                            if not allFishData[fishName] then
                                table.insert(fishList, fishName)
                                allFishData[fishName] = {
                                    Name = fishName,
                                    Zone = zoneName,
                                    Data = fishData
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Sort alphabetically
    table.sort(fishList)
    
    return fishList
end

local function RefreshFishList()
    local fishNames = GetAllFish()
    
    if #fishNames == 0 then
        fishNames = {"No fish found"}
    end
    
    -- Use :Refresh() method to update dropdown
    if fishDropdown then
        fishDropdown:Refresh(fishNames)
    end
    
    WindUI:Notify({
        Title = "Fish List",
        Content = string.format("Found %d fish types", #fishNames),
        Duration = 3,
        Icon = "fish"
    })
end

