local autoFishToggle = autoFishSection:Toggle({
    Title = "Auto Fishing",
    Desc = "Automatically catch fish with instant completion",
    Icon = "fish",
    Value = false,
    Callback = function(state)
        autoFishRunning = state
        
        if state then
            if autoFishThread then task.cancel(autoFishThread) end
            
            autoFishThread = task.spawn(function()
                local catchCount = 0
                local failCount = 0
                local notFoundCount = 0
                
                while autoFishRunning do
                    local fishUUID, fishInstance, errorMsg = GetFishUUID()
                    
                    if fishUUID and fishInstance then
                        local success, message = InstantCatch(fishUUID, fishInstance)
                        
                        if success then
                            catchCount = catchCount + 1
                        else
                            failCount = failCount + 1
                            print("[Auto Fish] Error:", message)
                        end
                        
                        -- Update status every 10 catches
                        if catchCount % 10 == 0 then
                            WindUI:Notify({
                                Title = "Auto Fishing",
                                Content = string.format("Caught: %d | Failed: %d", catchCount, failCount),
                                Duration = 2,
                                Icon = "fish"
                            })
                        end
                    else
                        -- Fish not found
                        notFoundCount = notFoundCount + 1
                        
                        if notFoundCount == 1 then
                            -- Show error on first occurrence
                            WindUI:Notify({
                                Title = "Fish Not Found",
                                Content = errorMsg or "No fish available",
                                Duration = 3,
                                Icon = "alert-circle"
                            })
                        end
                        
                        -- Wait longer when fish not found
                        task.wait(2)
                    end
                    
                    task.wait(catchDelay)
                end
                
                -- Final stats
                WindUI:Notify({
                    Title = "Auto Fishing Stopped",
                    Content = string.format("Total Caught: %d | Failed: %d", catchCount, failCount),
                    Duration = 5,
                    Icon = "check"
                })
            end)
        else
            if autoFishThread then
                task.cancel(autoFishThread)
                autoFishThread = nil
            end
        end
    end
})
AddConfig("AutoFish_Toggle", autoFishToggle)

