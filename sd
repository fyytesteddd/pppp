local autoOxygenToggle = oxygenSection:Toggle({
    Title = "Auto Oxygen Refill",
    Desc = "Auto teleport to Kraken when oxygen low",
    Icon = "wind",
    Value = false,
    Callback = function(state)
        autoOxygenRunning = state
        
        if state then
            if autoOxygenThread then task.cancel(autoOxygenThread) end
            
            autoOxygenThread = task.spawn(function()
                local refillCount = 0
                
                while autoOxygenRunning do
                    local currentOxygen = GetOxygenValue()
                    
                    if currentOxygen and currentOxygen <= oxygenThreshold then
                        -- Oxygen low, teleport to Kraken
                        local tpSuccess = TeleportToKraken()
                        
                        if tpSuccess then
                            -- Wait for oxygen to refill (very fast)
                            task.wait(0.5)
                            
                            -- Return to saved position
                            ReturnToSavedPosition()
                            
                            refillCount = refillCount + 1
                            
                            WindUI:Notify({
                                Title = "Oxygen Refilled",
                                Content = string.format("Refill #%d | Threshold: %d", refillCount, oxygenThreshold),
                                Duration = 2,
                                Icon = "wind"
                            })
                        end
                    end
                    
                    task.wait(0.5)  -- Check every 0.5s
                end
            end)
        else
            if autoOxygenThread then
                task.cancel(autoOxygenThread)
                autoOxygenThread = nil
            end
        end
    end
})
AddConfig("AutoOxygen_Toggle", autoOxygenToggle)

