local autoFishSection = Main:Section({Title = "Auto Fishing", Box = true, TextSize = 16})

local autoFishRunning = false
local autoFishThread = nil
local catchDelay = 0.5

local RS = game:GetService("ReplicatedStorage")
local HarpoonService = RS:WaitForChild("common"):WaitForChild("packages"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("HarpoonService")
local MinigameService = RS:WaitForChild("common"):WaitForChild("packages"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("MinigameService")

local StartCatchingRF = HarpoonService:WaitForChild("RF"):WaitForChild("StartCatching")
local MinigameUpdateRF = MinigameService:WaitForChild("RF"):WaitForChild("Update")

local function GetFishUUID()
    -- Find fish in workspace that matches selected fish name
    local fishFolder = workspace:FindFirstChild("Game")
    if fishFolder then
        fishFolder = fishFolder:FindFirstChild("Fish")
        if fishFolder then
            fishFolder = fishFolder:FindFirstChild("client")
            if fishFolder then
                print("[DEBUG] Fish folder found, checking children...")
                print("[DEBUG] Selected fish:", selectedFish)
                
                -- If no fish selected, get first available
                if not selectedFish or selectedFish == "Click Refresh to load fish" then
                    local fishList = fishFolder:GetChildren()
                    if #fishList > 0 then
                        print("[DEBUG] No fish selected, returning first available")
                        return fishList[1].Name, fishList[1]
                    end
                else
                    -- Find fish that matches selected name
                    for _, fishInstance in ipairs(fishFolder:GetChildren()) do
                        local head = fishInstance:FindFirstChild("Head")
                        if head then
                            local children = head:GetChildren()
                            print("[DEBUG] Fish UUID:", fishInstance.Name)
                            print("[DEBUG] Head children count:", #children)
                            
                            if children[2] then
                                local fishName = children[2].Name
                                print("[DEBUG] Fish name from Head[2]:", fishName)
                                
                                -- Check if this fish matches selected fish
                                if fishName == selectedFish then
                                    print("[DEBUG] MATCH FOUND!")
                                    return fishInstance.Name, fishInstance
                                end
                            else
                                print("[DEBUG] No children[2] in Head")
                            end
                        else
                            print("[DEBUG] No Head found for UUID:", fishInstance.Name)
                        end
                    end
                    
                    -- Selected fish not found
                    print("[DEBUG] Fish not found after scanning all instances")
                    return nil, nil, "Fish '" .. selectedFish .. "' not found in workspace"
                end
            end
        end
    end
    return nil, nil, "No fish available"
end

local function TeleportToFish(fishInstance)
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then return false end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    -- Get fish position
    local fishPosition = fishInstance:GetPivot().Position
    
    -- Teleport to fish (offset slightly above)
    humanoidRootPart.CFrame = CFrame.new(fishPosition + Vector3.new(0, 3, 0))
    
    return true
end

local function InstantCatch(fishUUID, fishInstance)
    -- Teleport to fish first
    local tpSuccess = TeleportToFish(fishInstance)
    if not tpSuccess then
        return false, "Failed to teleport"
    end
    
    task.wait(0.2)  -- Wait for teleport to register
    
    -- Start catching
    local success1, result1 = pcall(function()
        return StartCatchingRF:InvokeServer(fishUUID)
    end)
    
    if not success1 then
        return false, "Failed to start catching: " .. tostring(result1)
    end
    
    task.wait(0.1)
    
    -- Instant complete with progress = 1
    local success2, result2 = pcall(function()
        return MinigameUpdateRF:InvokeServer("ProgressUpdate", {
            progress = 1,
            rewards = {}
        })
    end)
    
    if not success2 then
        return false, "Failed to complete catch: " .. tostring(result2)
    end
    
    return true, "Caught!"
end

