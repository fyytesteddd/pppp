-- Auto Oxygen Refill
local oxygenSection = Main:Section({Title = "Auto Oxygen", Box = true, TextSize = 16})

local autoOxygenRunning = false
local autoOxygenThread = nil
local oxygenThreshold = 10
local savedPosition = nil

local function GetOxygenValue()
    local player = game:GetService("Players").LocalPlayer
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local mainGui = playerGui:FindFirstChild("Main")
    if not mainGui then return nil end
    
    local oxygenFrame = mainGui:FindFirstChild("Oxygen")
    if not oxygenFrame then return nil end
    
    local canvasGroup = oxygenFrame:FindFirstChild("CanvasGroup")
    if not canvasGroup then return nil end
    
    local oxygenText = canvasGroup:FindFirstChild("Oxygen")
    if not oxygenText then return nil end
    
    -- Parse oxygen value from text (e.g., "50" from text)
    local text = oxygenText.Text
    local value = tonumber(text)
    
    return value
end

local function TeleportToKraken()
    local kraken = workspace:FindFirstChild("Game")
    if kraken then
        kraken = kraken:FindFirstChild("Interactables")
        if kraken then
            kraken = kraken:FindFirstChild("Npc")
            if kraken then
                kraken = kraken:FindFirstChild("Kraken")
                if kraken then
                    local player = game:GetService("Players").LocalPlayer
                    local character = player.Character
                    if not character then return false end
                    
                    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
                    if not humanoidRootPart then return false end
                    
                    -- Save current position
                    savedPosition = humanoidRootPart.CFrame
                    
                    -- Teleport to Kraken
                    local krakenPosition = kraken:GetPivot().Position
                    humanoidRootPart.CFrame = CFrame.new(krakenPosition + Vector3.new(0, 3, 0))
                    
                    return true
                end
            end
        end
    end
    return false
end

local function ReturnToSavedPosition()
    if not savedPosition then return false end
    
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then return false end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    humanoidRootPart.CFrame = savedPosition
    
    return true
end

local oxygenThresholdInput = oxygenSection:Input({
    Title = "Oxygen Threshold",
    Desc = "Teleport to Kraken when oxygen below this value",
    Value = "10",
    Placeholder = "Enter threshold (e.g., 10)",
    Callback = function(value)
        local num = tonumber(value)
        if num then
            oxygenThreshold = num
        end
    end
})
